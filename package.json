{
  "name": "labweb-behavior-experiment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test scripts/test-experiment.cjs",
    "test:database": "node --test scripts/test-database.cjs",
    "test:api": "node --test scripts/test-local-api.cjs",
    "qa:database": "node scripts/qa-server.cjs",
    "qa:app": "node scripts/qa-app.cjs",
    "materials:import": "node scripts/import-materials-table.cjs",
    "materials:check": "node scripts/verify-experiment-materials.cjs",
    "database:check": "node scripts/check-database.cjs",
    "netlify:login": "npx --yes netlify-cli@23 login",
    "netlify:link": "npx --yes netlify-cli@23 link",
    "netlify:init": "npx --yes netlify-cli@23 init --manual",
    "deploy:preview": "npm run materials:check && npx --yes netlify-cli@23 deploy --build",
    "deploy": "npm run materials:check && npx --yes netlify-cli@23 deploy --build --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "undici": "^8.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
